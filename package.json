{
	"name": "beeprojects",
	"version": "0.1.0",
	"private": true,
	"type": "module",
	"imports": {
		"#lib": "./src/lib/index.js",
		"#lib/*": "./src/lib/*"
	},
	"engines": {
		"node": ">=22.17"
	},
	"packageManager": "pnpm@9.12.0",
	"scripts": {
		"dev": "vite dev",
		"build": "vite build",
		"preview": "vite preview",
		"start": "NODE_ENV=production node --env-file=.env build",
		"prepare": "svelte-kit sync || echo ''",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"lint": "prettier --check . && eslint .",
		"format": "prettier --write .",
		"test": "vitest run --passWithNoTests",
		"test:watch": "vitest",
		"test:e2e": "playwright test",
		"db:migrate": "node --env-file=.env --import tsx scripts/migrate.ts",
		"db:seed": "node --env-file=.env --import tsx scripts/seed.ts"
	},
	"dependencies": {
		"@fontsource-variable/inter": "^5.3.0",
		"@lucide/svelte": "^1.73.0",
		"@node-rs/argon2": "^2.2.2",
		"better-sqlite3": "^13.2.0",
		"bits-ui": "^2.21.0",
		"clsx": "^2.1.1",
		"date-fns": "^4.4.0",
		"file-type": "^22.3.0",
		"svelte-dnd-action": "^0.9.80",
		"svelte-sonner": "^1.2.3",
		"sveltekit-superforms": "^3.1.0",
		"tailwind-merge": "^3.7.0",
		"tailwind-variants": "^4.0.2",
		"zod": "^4.6.7"
	},
	"devDependencies": {
		"@eslint/js": "^10.0.1",
		"@playwright/test": "^1.65.1",
		"@sveltejs/adapter-node": "^6.0.2",
		"@sveltejs/kit": "^3.2.0",
		"@sveltejs/vite-plugin-svelte": "^7.3.1",
		"@tailwindcss/vite": "^4.3.5",
		"@types/better-sqlite3": "^9.6.0",
		"@types/node": "^22",
		"eslint": "^10.4.1",
		"eslint-config-prettier": "^10.1.8",
		"eslint-plugin-svelte": "^3.24.1",
		"globals": "^17.14.0",
		"prettier": "^3.10.1",
		"prettier-plugin-svelte": "^4.1.1",
		"prettier-plugin-tailwindcss": "^0.8.0",
		"svelte": "^5.57.3",
		"svelte-check": "^4.7.8",
		"tailwindcss": "^4.3.5",
		"tsx": "^4.23.15",
		"typescript": "^6.0.3",
		"typescript-eslint": "^8.72.2",
		"vite": "^8.3.8",
		"vitest": "^5.1.0",
		"vitest-browser-svelte": "^3.1.0"
	}
}
